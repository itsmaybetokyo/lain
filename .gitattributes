# En el repo todo va con LF; git hace la conversión en cada working tree.
* text=auto eol=lf

# Lo que en Windows necesita CRLF de verdad.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios: que git no intente convertirlos ni mostrarlos como diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp3 binary
*.wav binary
*.ogg binary
*.exe binary
*.dll binary

# El lockfile es generado.
package-lock.json linguist-generated=true
